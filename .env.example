# 后台管理密码。
ADMIN_PASSWORD=change-me
# 后台登录 Cookie 签名密钥，生产环境必须改成随机长字符串。
SESSION_SECRET=change-me-session-secret
# SQLite 数据库路径。
DATABASE_PATH=./data/app.db

# Gmail IMAP 配置。
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
MAIL_FETCH_LIMIT=5
DEFAULT_READ_LOCATION=inbox

# RoxyBrowser 本地 API 地址；可直接填 ROXY_API_BASE_URL，或只填 ROXY_API_PORT。
ROXY_API_BASE_URL=
ROXY_API_PORT=
# RoxyBrowser API token；如果 Roxy API 不需要 token 可留空。
ROXY_API_TOKEN=
# RoxyBrowser workspace 和目标窗口定位配置。
ROXY_WORKSPACE_ID=1
ROXY_BROWSER_DIR_ID=
ROXY_BROWSER_SORT_NUM=
ROXY_BROWSER_WINDOW_NAME=
# 复用已有 Roxy CDP 时填写；填写后会跳过开窗、清缓存、随机指纹等准备步骤。
ROXY_CDP_ENDPOINT=
# 当前补号要登录的 OpenAI/Codex 邮箱；补号接口会按账号行自动注入。
ROXY_OAUTH_EMAIL=
# 手机验证码 SMS API；补号接口会按账号行自动注入。
PHONE_VERIFICATION_SMS_API_URL=
# 补号/注册自动化运行日志最大保留条数；超过后自动清理旧数据库记录和日志文件。
REPLACEMENT_AUTOMATION_LOG_MAX_RUNS=30
# 邮箱验证码读取 API。
VERIFICATION_CODE_API_URL=http://127.0.0.1:3000/api/verification-code/latest
# 调用验证码 API 的后台 admin_auth Cookie；本机请求通常可留空。
ADMIN_AUTH_COOKIE=
# Roxy 调试/上线运行策略：
# - ROXY_KEEP_OPEN=1：调试模式，默认有头运行，流程结束后保留 Roxy 窗口。
# - ROXY_KEEP_OPEN=0：上线模式，默认无头运行，流程结束后关闭 Roxy 窗口。
ROXY_KEEP_OPEN=1
# ROXY_HEADLESS=auto 表示按 ROXY_KEEP_OPEN 推导；也可显式设为 true/false 覆盖。
ROXY_HEADLESS=auto
# 开始自动化前是否先关闭已有目标 Roxy 窗口；1=关闭后重开，0=不主动关闭。
ROXY_ENSURE_CLOSED=1
# 浏览器阶段使用 Roxy 代理；token exchange 仍在页面 fetch 中完成。
ROXY_PROXY=

# CPA 管理接口配置；用于读取 auth-files、上传补号后生成的 CPA JSON。
CPA_URL=http://localhost:8317
CPA_MANAGEMENT_KEY=
# CPA 自动健康监控守护进程；true 时后端启动后按间隔自动检测并补号。
CPA_HEALTH_MONITOR_ENABLED=false
CPA_HEALTH_MONITOR_INTERVAL_MS=600000
