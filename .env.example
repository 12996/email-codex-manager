# 后台管理密码。
ADMIN_PASSWORD=change-me
# 后台登录 Cookie 签名密钥，生产环境必须改成随机长字符串。
SESSION_SECRET=change-me-session-secret
# SQLite 数据库路径。
DATABASE_PATH=./data/app.db
# Web 服务监听端口；若 Windows 将 3000 加入排除端口范围，可改用 3100。
PORT=3100

# Gmail IMAP 配置。
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
# 可选：让 Gmail IMAP 走固定代理出口。直接启动 npm start 时可填外部代理；
# 使用 npm run start:proxy 或 start:home-proxy 时会由启动器注入 socks5://127.0.0.1:11080。
IMAP_PROXY=
# npm run start:proxy 使用：SSH 动态 SOCKS5 隧道目标与本地监听。
IMAP_PROXY_SSH_HOST=vps-LA
IMAP_PROXY_LOCAL_HOST=127.0.0.1
IMAP_PROXY_LOCAL_PORT=11080
# npm run start:home-proxy 使用：本地端口转发到 vps-LA 上的家宽代理。
IMAP_HOME_PROXY_SSH_HOST=vps-LA
IMAP_HOME_PROXY_LOCAL_HOST=127.0.0.1
IMAP_HOME_PROXY_LOCAL_PORT=11080
IMAP_HOME_PROXY_REMOTE_HOST=127.0.0.1
IMAP_HOME_PROXY_REMOTE_PORT=7891
MAIL_FETCH_LIMIT=5
DEFAULT_READ_LOCATION=inbox
# iCloud 验证码统一投递到 Gmail 时的默认收件账号；接口也可在请求体中传 gmailAccount 覆盖。
ICLOUD_CODE_GMAIL_ACCOUNT=rosannathornton1@gmail.com

# RoxyBrowser 本地 API 地址；可直接填 ROXY_API_BASE_URL，或只填 ROXY_API_PORT。
ROXY_API_BASE_URL=
ROXY_API_PORT=
# RoxyBrowser API token；如果 Roxy API 不需要 token 可留空。
ROXY_API_TOKEN=
# RoxyBrowser workspace 和目标窗口定位配置。
ROXY_WORKSPACE_ID=1
ROXY_BROWSER_DIR_ID=
ROXY_BROWSER_SORT_NUM=
ROXY_BROWSER_WINDOW_NAME=
# 复用已有 Roxy CDP 时填写；填写后会跳过开窗、清缓存、随机指纹等准备步骤。
ROXY_CDP_ENDPOINT=
# 可选：按自动化动作覆盖 Roxy 目标窗口。配置任意动作级窗口变量后，会覆盖上面的全局窗口定位；
# 若未配置动作级 CDP，会同时清除全局 ROXY_CDP_ENDPOINT，避免所有动作误复用同一窗口。
# 注册专用窗口。
ROXY_REGISTER_BROWSER_DIR_ID=
ROXY_REGISTER_BROWSER_SORT_NUM=
ROXY_REGISTER_BROWSER_WINDOW_NAME=
ROXY_REGISTER_CDP_ENDPOINT=
# 普通补号专用窗口。
ROXY_REPLACE_BROWSER_DIR_ID=
ROXY_REPLACE_BROWSER_SORT_NUM=
ROXY_REPLACE_BROWSER_WINDOW_NAME=
ROXY_REPLACE_CDP_ENDPOINT=
# 2FA 补号专用窗口。
ROXY_REPLACE_2FA_BROWSER_DIR_ID=
ROXY_REPLACE_2FA_BROWSER_SORT_NUM=
ROXY_REPLACE_2FA_BROWSER_WINDOW_NAME=
ROXY_REPLACE_2FA_CDP_ENDPOINT=
# 2FA 登录专用窗口。
ROXY_2FA_LOGIN_BROWSER_DIR_ID=
ROXY_2FA_LOGIN_BROWSER_SORT_NUM=
ROXY_2FA_LOGIN_BROWSER_WINDOW_NAME=
ROXY_2FA_LOGIN_CDP_ENDPOINT=
# 当前补号要登录的 OpenAI/Codex 邮箱；补号接口会按账号行自动注入。
ROXY_OAUTH_EMAIL=
# 手机验证码 SMS API；补号接口会按账号行自动注入。
PHONE_VERIFICATION_SMS_API_URL=
# 补号/注册自动化运行日志最大保留条数；超过后自动清理旧数据库记录和日志文件。
REPLACEMENT_AUTOMATION_LOG_MAX_RUNS=30
# 邮箱验证码读取 API；留空时自动使用 http://127.0.0.1:${PORT}/api/verification-code/latest。
VERIFICATION_CODE_API_URL=
# 注册成功后保存 chatgpt.com/api/auth/session accessToken 的目录；留空时使用 src/auto/product_files/registration。
REGISTRATION_TOKEN_OUTPUT_DIR=
# 调用验证码 API 的后台 admin_auth Cookie；本机请求通常可留空。
ADMIN_AUTH_COOKIE=
# Roxy 调试/上线运行策略：
# - ROXY_KEEP_OPEN=1：调试模式，默认有头运行，流程结束后保留 Roxy 窗口。
# - ROXY_KEEP_OPEN=0：上线模式，默认无头运行，流程结束后关闭 Roxy 窗口。
ROXY_KEEP_OPEN=1
# ROXY_HEADLESS=auto 表示按 ROXY_KEEP_OPEN 推导；也可显式设为 true/false 覆盖。
ROXY_HEADLESS=auto
# 开始自动化前是否先关闭已有目标 Roxy 窗口；1=关闭后重开，0=不主动关闭。
ROXY_ENSURE_CLOSED=1
# 浏览器阶段使用 Roxy 代理；token exchange 仍在页面 fetch 中完成。
ROXY_PROXY=

# CPA 管理接口配置；用于读取 auth-files、上传补号后生成的 CPA JSON。
CPA_URL=http://localhost:8317
CPA_MANAGEMENT_KEY=
# CPA 自动健康监控守护进程；true 时后端启动后按间隔自动检测并补号。
CPA_HEALTH_MONITOR_ENABLED=false
CPA_HEALTH_MONITOR_INTERVAL_MS=600000
