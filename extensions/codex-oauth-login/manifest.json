{
  "manifest_version": 3,
  "name": "Codex JWT AT Login",
  "version": "0.1.0",
  "description": "Verify a Codex Agent Identity JWT locally and show redacted account status.",
  "incognito": "split",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Codex JWT AT Login"
  }
}
